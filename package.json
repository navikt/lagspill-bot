{
    "name": "lagspill",
    "version": "1.0.0",
    "license": "MIT",
    "packageManager": "yarn@4.9.4",
    "engines": {
        "node": "24"
    },
    "scripts": {
        "dev": "tsx watch src/index.ts | pino-pretty",
        "dev:db": "docker run -e POSTGRES_PASSWORD=postgres -p 5432:5432 -it postgres:16",
        "build": "esbuild src/index.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/index.js --external:pg-native --external:pino-pretty",
        "start": "node dist/index.js",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src tests",
        "test": "vitest run",
        "drizzle:generate": "drizzle-kit generate",
        "drizzle:migrate": "drizzle-kit migrate",
        "drizzle:studio": "drizzle-kit studio",
        "prepare": "husky"
    },
    "dependencies": {
        "@navikt/pino-logger": "^4.5.1",
        "@slack/bolt": "^4.7.3",
        "@slack/logger": "^4.0.1",
        "@slack/types": "^2.22.0",
        "date-fns": "^4.4.0",
        "drizzle-orm": "^0.45.2",
        "pg": "^8.16.3",
        "pino": "^9.14.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@navikt/eslint-config-teamsykmelding": "^8.1.1",
        "@types/pg": "^8.11.11",
        "@typescript-eslint/eslint-plugin": "^8.44.0",
        "@typescript-eslint/parser": "^8.44.0",
        "drizzle-kit": "^0.31.5",
        "esbuild": "^0.28.2",
        "eslint": "^8.57.1",
        "eslint-plugin-import": "^2.32.0",
        "husky": "^9.1.7",
        "lint-staged": "^16.4.0",
        "pino-pretty": "^13.1.3",
        "prettier": "^3.8.1",
        "tsx": "^4.19.0",
        "typescript": "^5.9.3",
        "vitest": "^4.1.11"
    },
    "resolutions": {
        "postcss": "8.5.12"
    },
    "prettier": "@navikt/eslint-config-teamsykmelding/prettier",
    "eslintConfig": {
        "extends": [
            "@navikt/eslint-config-teamsykmelding"
        ]
    }
}
