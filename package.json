{
  "name": "lagspill",
  "version": "1.0.0",
  "license": "MIT",
  "packageManager": "yarn@4.12.0",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "dev": "next dev | pino-pretty",
    "dev:db": "docker run -e POSTGRES_PASSWORD=postgres -p 5432:5432 -it postgres:14",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "bun test",
    "start:migrate": "yarn prisma:migrate && yarn start",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate-dev": "prisma migrate dev",
    "prisma:seed": "bun run seed/seed.ts | pino-pretty",
    "prepare": "husky"
  },
  "dependencies": {
    "@navikt/next-logger": "5.0.0",
    "@prisma/client": "6.16.1",
    "@slack/bolt": "^4.7.3",
    "@slack/logger": "^4.0.1",
    "@slack/types": "^2.22.0",
    "autoprefixer": "^10.5.4",
    "date-fns": "^4.4.0",
    "next": "^16.3.1",
    "next-logger": "^5.0.1",
    "nextleton": "^0.6.1",
    "pino": "^9.14.0",
    "prisma": "6.16.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "uuid": "^13.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@navikt/eslint-config-teamsykmelding": "^8.1.1",
    "@types/react": "19.1.13",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "eslint": "^9",
    "eslint-config-next": "^16.3.1",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.1",
    "prettier-plugin-prisma": "^5.0.0",
    "typescript": "^5.9.3"
  },
  "resolutions": {
    "postcss": "8.5.12"
  },
  "prettier": "@navikt/eslint-config-teamsykmelding/prettier"
}
